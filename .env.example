# Copy this file to .env and fill in. NEVER commit .env to GitHub.

# mock   = no API key needed; questions are understood by keyword rules
# gemini = Gemini interprets questions (keyword rules are the automatic fallback)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# Let the LLM write validated, read-only SQL for questions outside the built-in types
ENABLE_TEXT_TO_SQL=true

# Optional overrides
# CSV_PATH=data/sales.csv
# DB_PATH=data/sales.db
