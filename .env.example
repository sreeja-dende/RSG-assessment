# Copy this file to .env and fill in. NEVER commit .env to GitHub.
DATABASE_URL=sqlite:///./app.db

# mock = works offline, no key. Switch to gemini (free key) when ready.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
